<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Checklist — Inventário de Ativos do Empreendimento</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@2.44.0/tabler-icons.min.css">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg: #0D1B2A;
    --bg2: #112236;
    --bg3: rgba(255,255,255,0.04);
    --border: rgba(255,255,255,0.08);
    --border2: rgba(255,255,255,0.14);
    --text: #fff;
    --text2: rgba(255,255,255,0.65);
    --text3: rgba(255,255,255,0.35);
    --green: #1D9E75;
    --green-bg: rgba(29,158,117,0.12);
    --green-border: rgba(29,158,117,0.3);
  }

  html, body {
    min-height: 100%;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 16px;
    line-height: 1.5;
  }

  body {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 40px 20px 60px;
  }

  /* ── Header ── */
  .page-header {
    width: 100%;
    max-width: 960px;
    margin-bottom: 32px;
  }
  .page-header h1 {
    font-size: 22px;
    font-weight: 500;
    color: var(--text);
    margin-bottom: 4px;
  }
  .page-header p {
    font-size: 14px;
    color: var(--text3);
  }
  .page-header .author {
    margin-top: 10px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text3);
  }
  .author-dot {
    width: 28px; height: 28px;
    border-radius: 50%;
    background: #1D3A5A;
    display: flex; align-items: center; justify-content: center;
    font-size: 11px; font-weight: 500; color: #7FB3D3;
  }

  /* ── Legend ── */
  .legend {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }
  .legend-item {
    display: flex; align-items: center; gap: 5px;
    font-size: 12px; color: var(--text3);
  }
  .badge {
    font-size: 10px; font-weight: 500;
    padding: 2px 8px; border-radius: 10px;
    display: inline-block;
  }
  .badge-inpi   { background: #EEEDFE; color: #3C3489; }
  .badge-auto   { background: #E1F5EE; color: #085041; }
  .badge-nda    { background: #FAEEDA; color: #633806; }

  /* ── Progress ── */
  .progress-card {
    width: 100%;
    max-width: 960px;
    background: var(--bg2);
    border: 0.5px solid var(--border2);
    border-radius: 12px;
    padding: 18px 22px;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .prog-numbers { white-space: nowrap; }
  .prog-big { font-size: 28px; font-weight: 500; color: var(--green); line-height: 1; }
  .prog-total { font-size: 14px; color: var(--text3); }
  .prog-bar-wrap { flex: 1; }
  .prog-bar-bg { height: 6px; background: var(--border); border-radius: 3px; }
  .prog-bar-fg { height: 6px; background: var(--green); border-radius: 3px; width: 0%; transition: width .3s; }
  .prog-msg { font-size: 13px; color: var(--text2); margin-top: 6px; }
  .reset-btn {
    background: transparent;
    border: 0.5px solid var(--border2);
    border-radius: 8px;
    padding: 7px 14px;
    color: var(--text3);
    font-size: 12px;
    cursor: pointer;
    transition: background .15s, color .15s;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
  }
  .reset-btn:hover { background: rgba(255,255,255,0.06); color: var(--text2); }
  .reset-btn:focus { outline: 2px solid var(--green); outline-offset: 2px; }

  /* ── Grid ── */
  .grid {
    width: 100%;
    max-width: 960px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 16px;
  }

  .col-card {
    background: var(--bg2);
    border: 0.5px solid var(--border2);
    border-radius: 12px;
    padding: 14px 14px 10px;
  }

  .col-title {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--text3);
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .col-title i { font-size: 13px; }

  .items-group {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 8px;
    min-height: 44px;
    background: var(--bg3);
    border: 0.5px solid var(--border);
    border-radius: 7px;
    cursor: pointer;
    transition: background .15s, border-color .15s, box-shadow .15s;
    user-select: none;
  }
  .item:last-child { margin-bottom: 0; }
  .item:hover { background: rgba(255,255,255,0.07); }
  .item:focus-within { box-shadow: 0 0 0 2px rgba(29,158,117,0.4); }
  .item.done {
    background: var(--green-bg);
    border-color: var(--green-border);
  }

  .cb {
    width: 18px; height: 18px; flex-shrink: 0;
    border: 1.5px solid rgba(255,255,255,0.25);
    border-radius: 4px;
    display: flex; align-items: center; justify-content: center;
    transition: background .15s, border-color .15s, transform .15s;
    cursor: pointer;
  }
  .cb:active { transform: scale(0.95); }
  .cb.checked { 
    background: var(--green); 
    border-color: var(--green);
    animation: checkPop .3s ease;
  }
  .cb.checked::after {
    content: '';
    display: block;
    width: 4px; height: 7px;
    border: 1.5px solid #fff;
    border-top: none; border-left: none;
    transform: rotate(45deg) translateY(-1px);
  }

  @keyframes checkPop {
    0% { transform: scale(0.8); }
    50% { transform: scale(1.1); }
    100% { transform: scale(1); }
  }

  .item-text { flex: 1; min-width: 0; }
  .item-label {
    font-size: 12px;
    color: var(--text2);
    line-height: 1.35;
    display: block;
  }
  .item-hint {
    font-size: 11px;
    color: var(--text3);
    display: block;
    margin-top: 2px;
  }
  .item.done .item-label { color: var(--text3); text-decoration: line-through; }
  .item.done .item-hint  { color: rgba(255,255,255,0.2); text-decoration: line-through; }

  .tag {
    display: inline-block;
    font-size: 9px; font-weight: 500;
    padding: 1px 5px; border-radius: 6px;
    margin-left: 4px; vertical-align: middle;
  }

  /* ── Footer ── */
  .page-footer {
    width: 100%; max-width: 960px;
    margin-top: 32px;
    text-align: center;
    font-size: 12px;
    color: var(--text3);
    border-top: 0.5px solid var(--border);
    padding-top: 20px;
  }
  .page-footer a { color: var(--green); text-decoration: none; }
  .page-footer a:hover { text-decoration: underline; }

  /* ── Print ── */
  @media print {
    body { padding: 20px; background: #fff; color: #000; }
    .progress-card { display: none; }
    .reset-btn { display: none; }
    .item.done .item-label, 
    .item.done .item-hint { opacity: 0.6; }
    .cb { border-color: #000; }
    .cb.checked { background: #000; }
    .col-card { break-inside: avoid; }
  }

  /* ── Responsive ── */
  @media (max-width: 600px) {
    .progress-card { flex-wrap: wrap; }
    .grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 420px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
</head>
<body>

<header class="page-header">
