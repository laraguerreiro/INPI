<script>
  const TOTAL = 22;
  const STORAGE_KEY = 'ativos-checklist';
  const MSGS = [
    [0,  4,  "Comece marcando o que já tem documentado."],
    [5,  9,  "Bom começo — continue identificando seus ativos."],
    [10, 14, "Metade do caminho. Há ativos ocultos a descobrir."],
    [15, 19, "Inventário robusto. Falta pouco para o quadro completo."],
    [20, 22, "Inventário completo. Seu negócio está mapeado."]
  ];

  function count() {
    return document.querySelectorAll('.cb.checked').length;
  }

  function update() {
    const n = count();
    const pct = Math.round(n / TOTAL * 100);
    document.getElementById('prog-n').textContent = n;
    document.getElementById('prog-n').setAttribute('aria-label', `${n} ativos marcados`);
    document.getElementById('prog-bar').style.width = pct + '%';
    document.getElementById('prog-bar').setAttribute('aria-valuenow', pct);
    const m = MSGS.find(r => n >= r[0] && n <= r[1]);
    if (m) document.getElementById('prog-msg').textContent = m[2];
    saveToStorage();
  }

  function tog(el, e) {
    if (e && e.type === 'keydown') {
      if (e.key !== ' ' && e.key !== 'Enter') return;
      e.preventDefault();
    }
    el.querySelector('.cb').classList.toggle('checked');
    el.classList.toggle('done');
    const isChecked = el.classList.contains('done');
    el.setAttribute('aria-checked', isChecked);
    update();
  }

  function resetAll() {
    if (count() === 0) return;
    document.querySelectorAll('.cb').forEach(cb => cb.classList.remove('checked'));
    document.querySelectorAll('.item').forEach(i => {
      i.classList.remove('done');
      i.setAttribute('aria-checked', 'false');
    });
    update();
  }

  function saveToStorage() {
    try {
      const checked = [];
      document.querySelectorAll('.item.done').forEach((item, idx) => {
        checked.push(idx);
      });
      localStorage.setItem(STORAGE_KEY, JSON.stringify(checked));
    } catch(e) {
      // quota exceeded or private mode
    }
  }

  function loadFromStorage() {
    try {
      const saved = JSON.parse(localStorage.getItem(STORAGE_KEY));
      if (saved && Array.isArray(saved)) {
        document.querySelectorAll('.item').forEach((item, idx) => {
          if (saved.includes(idx)) {
            item.classList.add('done');
            item.querySelector('.cb').classList.add('checked');
            item.setAttribute('aria-checked', 'true');
          }
        });
      }
    } catch(e) {
      // corrupted data, ignore
    }
    update();
  }

  // Attach click and keyboard handlers to all items
  function initItems() {
    document.querySelectorAll('.item').forEach(item => {
      item.addEventListener('click', function(e) {
        tog(this, e);
      });
      
      item.addEventListener('keydown', function(e) {
        tog(this, e);
      });
    });
  }

  // Initialize on load
  window.addEventListener('load', function() {
    loadFromStorage();
    initItems();
  });
</script>

</body>
